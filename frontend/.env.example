# Copy to .env.local for local overrides (git-ignored). The browser always talks to
# Keycloak directly (not through the gateway), so this needs to be reachable from
# your browser, not from inside Docker - localhost:8080 works for both `npm run dev`
# and the docker-compose frontend container, since Keycloak's port is published to the host.
VITE_KEYCLOAK_URL=http://localhost:8080
