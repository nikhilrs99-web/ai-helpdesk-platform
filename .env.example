# Copy this file to .env and fill in real local values.
# .env is git-ignored - never commit actual credentials, even local-dev-only ones.

POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk_app
POSTGRES_PASSWORD=changeme

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# ai-service needs a real key to call OpenAI - docker-compose.yml passes this straight
# through as OPENAI_API_KEY. Without it, ai-service still starts (application.yml falls
# back to a "demo-key" placeholder) but every real request to it will 401.
OPENAI_API_KEY=
